# Environment Variables
# Copy this to .env.local and fill in your Firebase config

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# LLM server (for "Parse with AI" feature)
# Dev: install Ollama locally (https://ollama.com) and run `ollama pull qwen3:8b`
# Prod: point to a hosted Ollama instance (Fly.io, your own VPS, etc.)
# Alternative: `qwen2.5:7b` if Qwen3 isn't available in your environment
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b